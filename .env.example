# Copy to .env  (PowerShell: Copy-Item .env.example .env). Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL=0

POSTGRES_DB=grocery_saas
POSTGRES_USER=grocery
POSTGRES_PASSWORD=change-me-db-password
# Used only when running Django outside Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dev only: generate migrations automatically inside the container (1) or not (0)
AUTO_MAKEMIGRATIONS=1
# Set to 1 to use a local SQLite file instead of PostgreSQL (quick tests only)
USE_SQLITE=0
