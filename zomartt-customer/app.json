{
  "expo": {
    "name": "Zomartt Customer",
    "slug": "zomartt-customer",
    "scheme": "zomarttcustomer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d131ba9e-75f7-44ee-8990-68d97f2a207d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zomartt.customer",
      "adaptiveIcon": {
        "backgroundColor": "#86498E",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      ["expo-location", { "locationWhenInUsePermission": "Zomartt uses your location to set the delivery address on the map." }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#86498E",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d131ba9e-75f7-44ee-8990-68d97f2a207d"
      }
    }
  }
}
