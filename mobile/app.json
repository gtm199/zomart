{
  "expo": {
    "name": "Zomartt",
    "slug": "zomartt",
    "scheme": "zomartt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bfe11d1e-e920-4825-b014-0aad431a515a"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zomartt to use the camera to scan product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      ["expo-build-properties", { "android": { "enableMinifyInReleaseBuilds": false } }],
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#86498E",
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.zomartt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#86498E"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfe11d1e-e920-4825-b014-0aad431a515a"
      }
    }
  }
}
